using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using RaceDay.API.Data;
using RaceDay.API.Dtos;
using System.Security.Claims;

namespace RaceDay.API.Controllers;

[ApiController]
[Route("api/[controller]")]
public class CategoriesController : ControllerBase
{
    private readonly ApplicationDbContext _db;
    public CategoriesController(ApplicationDbContext db) => _db = db;
    private int CurrentProfileId => int.Parse(User.FindFirstValue("ProfileId")!);

    /// <summary>Gets categories for an event. Public.</summary>
    [HttpGet("event/{eventId}")]
    public async Task<IActionResult> GetCategories(int eventId) => Ok(await _db.Categories.Where(c => c.EventId == eventId).ToListAsync());

    /// <summary>Adds a category. Organisers only.</summary>
    [Authorize(Roles = "Organiser")]
    [HttpPost("event/{eventId}")]
    public async Task<IActionResult> CreateCategory(int eventId, CategoryDto dto)
    {
        var ev = await _db.Events.FindAsync(eventId);
        if (ev == null || ev.OrganiserId != CurrentProfileId) return NotFound();
        var cat = new Models.Category { Name = dto.Name, DistanceKm = dto.DistanceKm, EntryFee = dto.EntryFee, EventId = eventId };
        _db.Categories.Add(cat);
        await _db.SaveChangesAsync();
        return Ok(cat);
    }
}
